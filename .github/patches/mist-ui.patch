index 0000000..0c4228c
--- /dev/null
+++ b/V2rayNG/app/src/main/java/com/v2ray/ang/ui/server/ServerMistActivity.kt
@@ -0,0 +1,90 @@
+package com.v2ray.ang.ui.server
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.saveable.rememberSaveable
+import androidx.compose.ui.res.stringResource
+import com.v2ray.ang.R
+import com.v2ray.ang.dto.entities.ProfileItem
+import com.v2ray.ang.enums.EConfigType
+import com.v2ray.ang.extension.toast
+import com.v2ray.ang.ui.compose.FormDropdownField
+import com.v2ray.ang.ui.compose.FormTextField
+import com.v2ray.ang.ui.compose.SettingsSwitchItem
+
+class ServerMistActivity : BaseServerActivity() {
+
+    override val serverConfigType: EConfigType = EConfigType.MIST
+
+    @Composable
+    override fun ScreenContent() {
+        val options = rememberFieldOptions()
+        val uiState = rememberSaveable(saver = ServerUiState.Saver) {
+            ServerUiState.from(
+                initialConfig = initialConfig
+            )
+        }.apply {
+            configType = EConfigType.MIST
+            if (fingerPrint.isEmpty()) fingerPrint = "chrome"
+            if (alpn.isEmpty()) alpn = "h2,http/1.1"
+        }
+
+        ServerEditorScaffold(
+            title = serverConfigType.toString(),
+            onSaveClick = { saveServer(uiState) }
+        ) {
+            CommonBasicFields(uiState)
+            MistProtocolFields(uiState, options)
+        }
+    }
+
+    override fun validateProtocolConfig(config: ProfileItem): Boolean {
+        if (config.mistClientId.isNullOrBlank()) {
+            toast(R.string.server_lab_mist_client_id)
+            return false
+        }
+        if (config.mistAuthKey.isNullOrBlank()) {
+            toast(R.string.server_lab_mist_auth_key)
+            return false
+        }
+        return true
+    }
+
+    @Composable
+    private fun MistProtocolFields(
+        state: ServerUiState,
+        options: BaseServerActivity.FieldOptions
+    ) {
+        FormTextField(
+            label = stringResource(R.string.server_lab_mist_client_id),
+            value = state.mistClientId,
+            onValueChange = { state.mistClientId = it }
+        )
+        FormTextField(
+            label = stringResource(R.string.server_lab_mist_auth_key),
+            value = state.mistAuthKey,
+            onValueChange = { state.mistAuthKey = it }
+        )
+        FormTextField(
+            label = stringResource(R.string.server_lab_sni),
+            value = state.sni,
+            onValueChange = { state.sni = it }
+        )
+        FormDropdownField(
+            label = stringResource(R.string.server_lab_stream_fingerprint),
+            value = state.fingerPrint,
+            options = options.uTlsOptions,
+            onValueChange = { state.fingerPrint = it }
+        )
+        FormDropdownField(
+            label = stringResource(R.string.server_lab_stream_alpn),
+            value = state.alpn,
+            options = options.alpnOptions,
+            onValueChange = { state.alpn = it }
+        )
+        SettingsSwitchItem(
+            title = stringResource(R.string.server_lab_allow_insecure),
+            checked = state.allowInsecure,
+            onCheckedChange = { state.allowInsecure = it }
+        )
+    }
+}
