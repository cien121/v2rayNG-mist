+    private fun toOutboundMist(profileItem: ProfileItem): OutboundBean? {
+        val outboundBean = createInitOutbound(EConfigType.MIST)
+
+        outboundBean?.settings?.let { settings ->
+            settings.address = getServerAddress(profileItem)
+            settings.port = profileItem.serverPort.orEmpty().toInt()
+            settings.clientId = profileItem.mistClientId.orEmpty()
+            settings.authKey = profileItem.mistAuthKey.orEmpty()
+        }
+
+        // Mist is always TLS over TCP; force stream security settings accordingly
+        profileItem.security = AppConfig.TLS
+        if (profileItem.fingerPrint.isNullOrEmpty()) {
+            profileItem.fingerPrint = "chrome"
+        }
+        if (profileItem.alpn.isNullOrEmpty()) {
+            profileItem.alpn = "h2,http/1.1"
+        }
+
+        outboundBean?.streamSettings?.let {
+            it.network = NetworkType.TCP.type
+            populateTlsSettings(it, profileItem, profileItem.sni.ifEmpty { profileItem.server })
+        }
+
+        return outboundBean
+    }
+
